# Linux release build environment for Voquill.
#
# Release binaries link against the glibc of the machine that builds them, and
# an AppImage additionally bundles that machine's libraries. Building on the
# oldest supported base (Ubuntu 22.04, glibc 2.35) keeps every Linux artifact
# runnable on Ubuntu 22.04+, Linux Mint 21+, Debian 12+ and current Fedora.
# Driven by scripts/build-linux-release.mjs; see docs/RELEASE.md.
FROM docker.io/library/ubuntu:22.04

ARG NODE_VERSION=22.23.1
ARG RUST_VERSION=1.97.1
ARG VULKAN_SDK_VERSION=1.4.341.1
ARG VULKAN_SDK_SHA256=3bf0f762afb6c79bc6a9d9fb5998745ccff928800a29619b501ed9de7fd9789b

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        appstream \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        desktop-file-utils \
        file \
        git \
        libasound2-dev \
        libayatana-appindicator3-dev \
        libclang-dev \
        libfuse2 \
        libgtk-3-dev \
        libgtk-layer-shell-dev \
        libpulse-dev \
        librsvg2-dev \
        libssl-dev \
        libudev-dev \
        libvulkan-dev \
        libwebkit2gtk-4.1-dev \
        patchelf \
        pkg-config \
        rsync \
        squashfs-tools \
        wl-clipboard \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04 ships neither glslc nor Vulkan headers new enough for
# whisper.cpp's ggml-vulkan backend, so use the pinned LunarG SDK for the
# shader compiler and headers. The Vulkan loader still comes from the distro
# (libvulkan-dev), so the binary and AppImage resolve the system loader.
RUN curl -fsSL -o /tmp/vulkan-sdk.tar.xz \
        "https://sdk.lunarg.com/sdk/download/${VULKAN_SDK_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_SDK_VERSION}.tar.xz" \
    && echo "${VULKAN_SDK_SHA256}  /tmp/vulkan-sdk.tar.xz" | sha256sum --check \
    && mkdir -p /opt/vulkan-sdk \
    && tar -xJf /tmp/vulkan-sdk.tar.xz -C /opt/vulkan-sdk --strip-components=2 "${VULKAN_SDK_VERSION}/x86_64" \
    && rm /tmp/vulkan-sdk.tar.xz
ENV VULKAN_SDK=/opt/vulkan-sdk \
    PATH=/opt/vulkan-sdk/bin:$PATH

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        | tar -xJ -C /usr/local --strip-components=1

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs \
        | sh -s -- -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}"

# linuxdeploy is itself an AppImage; containers have no FUSE, so let it
# extract itself instead of mounting.
ENV APPIMAGE_EXTRACT_AND_RUN=1

COPY build-in-container.sh /usr/local/bin/build-in-container.sh
ENTRYPOINT ["/usr/local/bin/build-in-container.sh"]
