[Desktop Entry]
# Tauri's bundler always generates a desktop file named after productName,
# which cannot match the org.voquill.desktop app ID. The real entry ships
# explicitly as org.voquill.desktop.desktop (bundle.linux.*.files); this
# generated copy is Hidden so it never appears as a second launcher.
Type=Application
Name=Voquill
Exec={{exec}}
Icon={{icon}}
Categories={{categories}}
Hidden=true
